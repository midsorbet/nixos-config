--- /dev/null
+++ b/internal/bookmarks/converter/epub_test.go
@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: © 2026 Readeck contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only
+
+package converter
+
+import "testing"
+
+func TestEPUBResourceNamesAreBookmarkScoped(t *testing.T) {
+	first := epubResourceName("bookmark-a", "_resources/shared.jpg")
+	second := epubResourceName("bookmark-b", "_resources/shared.jpg")
+	if first == second {
+		t.Fatalf("resource names collide: %q", first)
+	}
+	if first != "Images/bookmark-a/shared.jpg" {
+		t.Fatalf("unexpected resource name: %q", first)
+	}
+}
+
+func TestEPUBResourceIDsIncludeFullSourceName(t *testing.T) {
+	first := epubResourceID("bookmark-a", "_resources/shared.jpg")
+	second := epubResourceID("bookmark-a", "other/shared.jpg")
+	if first == second {
+		t.Fatalf("resource IDs collide: %q", first)
+	}
+}
